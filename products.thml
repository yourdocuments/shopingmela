     FOOTER
====================================================== -->

<footer class="footer">

    <div class="container">

        <div class="footer-bottom">

            © 2026 Shopping Mela.
            All Rights Reserved.

        </div>

    </div>

</footer>



<!-- =====================================================
     TOAST
====================================================== -->

<div
    class="product-toast"
    id="productToast"
>
    Done!
</div>



<script>

    /* =====================================================
       TOAST
    ====================================================== */

    function showProductToast(message) {

        const toast =
            document.getElementById(
                "productToast"
            );

        toast.textContent = message;

        toast.classList.add("show");

        setTimeout(() => {

            toast.classList.remove("show");

        }, 2500);

    }



    /* =====================================================
       IMAGE CHANGE
    ====================================================== */

    function changeProductImage(thumbnail) {

        const style =
            thumbnail.style.backgroundImage;

        const mainImage =
            document.getElementById(
                "mainProductImage"
            );

        mainImage.style.backgroundImage =
            style;


        document
            .querySelectorAll(".thumbnail")
            .forEach(item => {

                item.classList.remove(
                    "active"
                );

            });


        thumbnail.classList.add("active");

    }



    /* =====================================================
       QUANTITY
    ====================================================== */

    let quantity = 1;


    function increaseQuantity() {

        quantity++;

        document.getElementById(
            "quantity"
        ).textContent = quantity;

    }


    function decreaseQuantity() {

        if (quantity > 1) {

            quantity--;

        }

        document.getElementById(
            "quantity"
        ).textContent = quantity;

    }



    /* =====================================================
       ADD TO CART
    ====================================================== */

    function addToCart() {

        showProductToast(
            "Cart-এ " +
            quantity +
            "টি product যোগ করা হয়েছে 🛒"
        );

    }



    /* =====================================================
       BUY NOW
    ====================================================== */

    function buyNow() {

        showProductToast(
            "Order page শীঘ্রই আসছে ⚡"
        );

    }



    /* =====================================================
       SEARCH
    ====================================================== */

    function searchProduct() {

        const input =
            document.getElementById(
                "productSearch"
            );

        const query =
            input.value.trim();


        if (!query) {

            showProductToast(
                "কিছু search করুন 🔍"
            );

            return;

        }


        window.location.href =
            "products.html?search=" +
            encodeURIComponent(query);

    }


    document
        .getElementById("productSearch")
        .addEventListener(
            "keydown",
            function(event) {

                if (
                    event.key === "Enter"
                ) {

                    searchProduct();

                }

            }
        );



    /* =====================================================
       RELATED PRODUCT
    ====================================================== */

    function openProduct(productName) {

        showProductToast(
            productName +
            " product page শীঘ্রই আসছে!"
        );

    }

</script>


</body>
</html>
