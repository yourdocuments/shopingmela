<!DOCTYPE html>
<html lang="bn">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Products — Shopping Mela
    </title>

    <meta
        name="description"
        content="Shopping Mela Products — local sellers-এর products, offers এবং verified businesses."
    >

    <link
        rel="stylesheet"
        href="style.css"
    >

    <style>

        /* =================================================
           PRODUCTS PAGE EXTRA CSS
        ================================================= */

        .products-page-hero {

            padding: 50px 0 30px;

        }


        .products-hero-box {

            background:
                linear-gradient(
                    135deg,
                    #111827,
                    #374151
                );

            border-radius: 24px;

            padding: 45px;

            color: white;

            position: relative;

            overflow: hidden;

        }


        .products-hero-box::after {

            content: "";

            position: absolute;

            width: 320px;
            height: 320px;

            border-radius: 50%;

            background:
                rgba(255,255,255,0.06);

            right: -90px;
            top: -120px;

        }


        .page-label {

            display: inline-flex;

            align-items: center;

            gap: 7px;

            padding: 7px 14px;

            border-radius: 50px;

            background:
                rgba(255,255,255,0.12);

            font-size: 13px;

            font-weight: 700;

        }


        .products-hero-box h1 {

            font-size:
                clamp(30px,5vw,50px);

            margin:
                12px 0;

        }


        .products-hero-box p {

            max-width: 700px;

            color: #d1d5db;

            line-height: 1.8;

        }


        .products-toolbar {

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 15px;

            flex-wrap: wrap;

            margin-bottom: 25px;

        }


        .product-search {

            display: flex;

            width:
                min(100%,430px);

            background: white;

            border:
                1px solid #e5e7eb;

            border-radius: 12px;

            overflow: hidden;

        }


        .product-search input {

            flex: 1;

            border: none;

            outline: none;

            padding: 14px;

            font-size: 15px;

        }


        .product-search button {

            border: none;

            background: #111827;

            color: white;

            padding:
                0 18px;

            cursor: pointer;

            font-size: 16px;

        }


        .product-filters {

            display: flex;

            flex-wrap: wrap;

            gap: 8px;

        }


        .product-filter {

            background: white;

            border:
                1px solid #e5e7eb;

            border-radius: 50px;

            padding:
                9px 15px;

            cursor: pointer;

            font-size: 13px;

            font-weight: 700;

        }


        .product-filter.active {

            background: #111827;

            color: white;

            border-color: #111827;

        }


        .products-count {

            font-size: 14px;

            color: #6b7280;

            margin-bottom: 18px;

        }


        .product-card.hidden {

            display: none;

        }


        .product-seller {

            display: flex;

            align-items: center;

            gap: 5px;

            font-size: 13px;

            color: #6b7280;

            margin:
                7px 0;

        }


        .verified-badge {

            display: inline-flex;

            align-items: center;

            justify-content: center;

            width: 18px;

            height: 18px;

            border-radius: 50%;

            background: #1877f2;

            color: white;

            font-size: 11px;

            font-weight: 900;

            box-shadow:
                0 1px 4px
                rgba(24,119,242,.35);

        }


        .product-view-btn {

            width: 100%;

            border: none;

            border-radius: 10px;

            padding: 11px;

            background: #111827;

            color: white;

            font-weight: 700;

            cursor: pointer;

            margin-top: 12px;

            transition:
                .2s ease;

        }


        .product-view-btn:hover {

            transform:
                translateY(-1px);

            opacity: .92;

        }


        .empty-products {

            display: none;

            text-align: center;

            padding: 60px 20px;

            background: white;

            border:
                1px solid #eee;

            border-radius: 18px;

        }


        .empty-products.show {

            display: block;

        }


        .empty-products-icon {

            font-size: 45px;

            margin-bottom: 10px;

        }


        .back-home {

            display: inline-flex;

            align-items: center;

            gap: 6px;

            text-decoration: none;

            color: #6b7280;

            font-weight: 600;

            margin-bottom: 20px;

        }


        @media(max-width:700px) {

            .products-hero-box {

                padding: 30px 22px;

            }

        }

    </style>

</head>



