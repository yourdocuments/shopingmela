<!DOCTYPE html>
<html lang="bn">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Products — Shopping Mela
    </title>

    <meta
        name="description"
        content="Shopping Mela Products — Local sellers, verified brands, offers and products."
    >

    <link
        rel="stylesheet"
        href="style.css"
    >

</head>


<body>


<!-- =====================================================
     TOP BAR
====================================================== -->

<div class="top-bar">

    🛍️

    <span>
        Shopping Mela
    </span>

    — Local Products & Verified Sellers

</div>



<!-- =====================================================
     HEADER
====================================================== -->

<header class="header">

    <div class="container">

        <div class="header-main">


            <!-- LOGO -->

            <a
                href="index.html"
                class="logo"
            >

                <div class="logo-icon">
                    🛍️
                </div>

                <span>
                    Shopping Mela
                </span>

            </a>



            <!-- SEARCH -->

            <div class="header-search">

                <input
                    type="search"
                    id="productSearch"
                    placeholder="পণ্য, brand বা category খুঁজুন..."
                    aria-label="Search products"
                >

                <button
                    type="button"
                    onclick="searchProducts()"
                    aria-label="Search"
                >
                    🔍
                </button>

            </div>



            <!-- HEADER ACTIONS -->

            <div class="header-actions">


                <button
                    class="header-action"
                    type="button"
                    onclick="openWishlist()"
                >

                    <span class="header-action-icon">
                        ♡
                    </span>

                    <span>
                        Wishlist
                    </span>

                    <b
                        class="header-count"
                        id="wishlistCount"
                    >
                        0
                    </b>

                </button>



                <button
                    class="header-action"
                    type="button"
                    onclick="openCart()"
                >

                    <span class="header-action-icon">
                        🛒
                    </span>

                    <span>
                        Cart
                    </span>

                    <b
                        class="header-count"
                        id="cartCount"
                    >
                        0
                    </b>

                </button>

            </div>

        </div>



        <!-- NAVIGATION -->

        <nav class="navigation">

            <div class="navigation-inner">

                <a href="index.html">
                    Home
                </a>

                <a href="index.html#categories">
                    Categories
                </a>

                <a href="brands.html">
                    Local Brands
                </a>

                <a
                    href="products.html"
                    class="active"
                >
                    Products
                </a>

                <a href="offers.html">
                    Offers
                </a>

                <a href="blog.html">
                    Blog
                </a>

                <a href="index.html#advertise">
                    Advertise With Us
                </a>

            </div>

        </nav>

    </div>

</header>



<main>


<!-- =====================================================
     PRODUCTS HERO
====================================================== -->

<section class="products-hero">

    <div class="container">

        <div class="products-hero-content">

            <span class="page-label">
                🛒 SHOPPING MELA MARKETPLACE
            </span>


            <h1>
                Local Products,
                Easy Shopping
            </h1>


            <p>
                আপনার এলাকার seller ও
                verified local brand-এর
                products এক জায়গায় খুঁজে নিন।
            </p>


            <div class="marketplace-points">

                <span>
                    🔵 Verified Sellers
                </span>

                <span>
                    💰 Local Offers
                </span>

                <span>
                    🛍️ Easy Shopping
                </span>

            </div>

        </div>

    </div>

</section>



<!-- =====================================================
     PRODUCTS
====================================================== -->

<section class="section">

    <div class="container">


        <!-- HEADING -->

        <div class="section-heading">

            <div>

                <h2>
                    All Products
                </h2>

                <p id="productResultText">
                    Local sellers-এর products
                </p>

            </div>


            <button
                class="sort-button"
                onclick="toggleSortMenu()"
            >
                ↕ Sort
            </button>

        </div>



        <!-- =================================================
             CATEGORY FILTER
        ================================================== -->

        <div class="product-filters">


            <button
                class="product-filter active"
                onclick="
                    filterProducts(
                        'all',
                        this
                    )
                "
            >
                All
            </button>


            <button
                class="product-filter"
                onclick="
                    filterProducts(
                        'Fashion',
                        this
                    )
                "
            >
                👗 Fashion
            </button>


            <button
                class="product-filter"
                onclick="
                    filterProducts(
                        'Beauty',
                        this
                    )
                "
            >
                💄 Beauty
            </button>


            <button
                class="product-filter"
                onclick="
                    filterProducts(
                        'Food',
                        this
                    )
                "
            >
                🍔 Food
            </button>


            <button
                class="product-filter"
                onclick="
                    filterProducts(
                        'Electronics',
                        this
                    )
                "
            >
                📱 Electronics
            </button>


            <button
                class="product-filter"
                onclick="
                    filterProducts(
                        'Home',
                        this
                    )
                "
            >
                🏠 Home
            </button>


            <button
                class="product-filter"
                onclick="
                    filterProducts(
                        'Handmade',
                        this
                    )
                "
            >
                ✨ Handmade
            </button>

        </div>



        <!-- =================================================
             SORT MENU
        ================================================== -->

        <div
            class="sort-menu"
            id="sortMenu"
        >

            <button
                onclick="sortProducts('default')"
            >
                Recommended
            </button>

            <button
                onclick="sortProducts('low')"
            >
                Price: Low to High
            </button>

            <button
                onclick="sortProducts('high')"
            >
                Price: High to Low
            </button>

            <button
                onclick="sortProducts('discount')"
            >
                Highest Discount
            </button>

        </div>



        <!-- =================================================
             PRODUCT GRID
        ================================================== -->

        <div
            class="market-product-grid"
            id="productGrid"
        >



            <!-- =================================================
                 PRODUCT 1
            ================================================== -->

            <article
                class="market-product-card"
                data-category="Fashion"
                data-name="
                    Ladies Three Piece
                "
                data-search="
                    ladies three piece
                    fashion anjona local
                "
                data-price="1250"
                data-discount="20"
            >

                <div
                    class="market-product-image"
                    style="
                        background-image:
                        url('https://images.unsplash.com/photo-1594633312681-425c7b97ccd1?auto=format&fit=crop&w=800&q=85');
                    "
                >

                    <span class="product-discount">
                        -20%
                    </span>


                    <button
                        class="market-wishlist"
                        onclick="
                            toggleWishlist(
                                this,
                                'Ladies Three Piece'
                            )
                        "
                    >
                        ♡
                    </button>

                </div>



                <div class="market-product-info">


                    <div class="product-label-row">

                        <span class="product-tag">
                            BEST SELLER
                        </span>

                    </div>



                    <div class="market-product-title-row">

                        <h3>
                            Ladies Three Piece
                        </h3>

                    </div>



                    <div class="seller-line">

                        <span>
                            Anjona Ladies Tailors
                        </span>

                        <span
                            class="seller-verified"
                            title="Shopping Mela Verified"
                            onclick="
                                showSellerVerification(
                                    'Anjona Ladies Tailors'
                                )
                            "
                        >
                            ✓
                        </span>

                    </div>



                    <div class="rating">

                        ⭐ 4.8

                        <small>
                            (24 reviews)
                        </small>

                    </div>



                    <div class="market-price">

                        <strong>
                            ৳1,250
                        </strong>

                        <del>
                            ৳1,550
                        </del>

                    </div>



                    <button
                        class="add-cart-btn"
                        onclick="
                            addToCart(
                                'Ladies Three Piece',
                                1250
                            )
                        "
                    >
                        🛒 Add to Cart
                    </button>

                </div>

            </article>



            <!-- =================================================
                 PRODUCT 2
            ================================================== -->

            <article
                class="market-product-card"
                data-category="Beauty"
                data-name="
                    Premium Attar
                "
                data-search="
                    premium attar perfume fragrance
                    beauty local attar shop
                "
                data-price="650"
                data-discount="15"
            >

                <div
                    class="market-product-image"
                    style="
                        background-image:
                        url('https://images.unsplash.com/photo-1541643600914-78b084683601?auto=format&fit=crop&w=800&q=85');
                    "
                >

                    <span class="product-discount">
                        -15%
                    </span>


                    <button
                        class="market-wishlist"
                        onclick="
                            toggleWishlist(
                                this,
                                'Premium Attar'
                            )
                        "
                    >
                        ♡
                    </button>

                </div>



                <div class="market-product-info">


                    <div class="product-label-row">

                        <span class="product-tag">
                            POPULAR
                        </span>

                    </div>


                    <h3>
                        Premium Attar
                    </h3>


                    <div class="seller-line">

                        <span>
                            Local Attar Shop
                        </span>

                        <span
                            class="seller-verified"
                            title="Shopping Mela Verified"
                            onclick="
                                showSellerVerification(
                                    'Local Attar Shop'
                                )
                            "
                        >
                            ✓
                        </span>

                    </div>


                    <div class="rating">

                        ⭐ 4.7

                        <small>
                            (18 reviews)
                        </small>

                    </div>


                    <div class="market-price">

                        <strong>
                            ৳650
                        </strong>

                        <del>
                            ৳750
                        </del>

                    </div>


                    <button
                        class="add-cart-btn"
                        onclick="
                            addToCart(
                                'Premium Attar',
                                650
                            )
                        "
                    >
                        🛒 Add to Cart
                    </button>

                </div>

            </article>



            <!-- =================================================
                 PRODUCT 3
            ================================================== -->

            <article
                class="market-product-card"
                data-category="Handmade"
                data-name="
                    Handmade Bag
                "
                data-search="
                    handmade bag local craft
                    fashion accessories
                "
                data-price="890"
                data-discount="0"
            >

                <div
                    class="market-product-image"
                    style="
                        background-image:
                        url('https://images.unsplash.com/photo-1584917865442-de89df76afd3?auto=format&fit=crop&w=800&q=85');
                    "
                >

                    <span class="product-new">
                        NEW
                    </span>


                    <button
                        class="market-wishlist"
                        onclick="
                            toggleWishlist(
                                this,
                                'Handmade Bag'
                            )
                        "
                    >
                        ♡
                    </button>

                </div>



                <div class="market-product-info">

                    <div class="product-label-row">

                        <span class="product-tag">
                            HANDMADE
                        </span>

                    </div>


                    <h3>
                        Handmade Bag
                    </h3>


                    <div class="seller-line">

                        <span>
                            Local Handmade Brand
                        </span>

                        <span
                            class="seller-verified"
                            title="Shopping Mela Verified"
                            onclick="
                                showSellerVerification(
                                    'Local Handmade Brand'
                                )
                            "
                        >
                            ✓
                        </span>

                    </div>


                    <div class="rating">

                        ⭐ 4.9

                        <small>
                            (12 reviews)
                        </small>

                    </div>


                    <div class="market-price">

                        <strong>
                            ৳890
                        </strong>

                    </div>


                    <button
                        class="add-cart-btn"
                        onclick="
                            addToCart(
                                'Handmade Bag',
                                890
                            )
                        "
                    >
                        🛒 Add to Cart
                    </button>

                </div>

            </article>



            <!-- =================================================
                 PRODUCT 4
            ================================================== -->

            <article
                class="market-product-card"
                data-category="Food"
                data-name="
                    Homemade Food
                "
                data-search="
                    homemade food snacks
                    local food
                "
                data-price="350"
                data-discount="0"
            >

                <div
                    class="market-product-image"
                    style="
                        background-image:
                        url('https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=800&q=85');
                    "
                >

                    <span class="product-hot">
                        HOT
                    </span>


                    <button
                        class="market-wishlist"
                        onclick="
                            toggleWishlist(
                                this,
                                'Homemade Food'
                            )
                        "
                    >
                        ♡
                    </button>

                </div>



                <div class="market-product-info">

                    <div class="product-label-row">

                        <span class="product-tag">
                            LOCAL FOOD
                        </span>

                    </div>


                    <h3>
                        Homemade Food
                    </h3>


                    <div class="seller-line">

                        <span>
                            Local Food House
                        </span>

                        <span
                            class="seller-verified"
                            title="Shopping Mela Verified"
                            onclick="
                                showSellerVerification(
                                    'Local Food House'
                                )
                            "
                        >
                            ✓
                        </span>

                    </div>


                    <div class="rating">

                        ⭐ 4.6

                        <small>
                            (31 reviews)
                        </small>

                    </div>


                    <div class="market-price">

                        <strong>
                            ৳350
                        </strong>

                    </div>


                    <button
                        class="add-cart-btn"
                        onclick="
                            addToCart(
                                'Homemade Food',
                                350
                            )
                        "
                    >
                        🛒 Add to Cart
                    </button>

                </div>

            </article>



            <!-- =================================================
                 PRODUCT 5
            ================================================== -->

            <article
                class="market-product-card"
                data-category="Electronics"
                data-name="
                    Mobile Accessories
                "
                data-search="
                    mobile accessories charger
                    electronics gadgets
                "
                data-price="450"
                data-discount="10"
            >

                <div
                    class="market-product-image"
                    style="
                        background-image:
                        url('https://images.unsplash.com/photo-1609592424213-1a8b4a0f6a3c?auto=format&fit=crop&w=800&q=85');
                    "
                >

                    <span class="product-discount">
                        -10%
                    </span>


                    <button
                        class="market-wishlist"
                        onclick="
                            toggleWishlist(
                                this,
                                'Mobile Accessories'
                            )
                        "
                    >
                        ♡
                    </button>

                </div>



                <div class="market-product-info">

                    <div class="product-label-row">

                        <span class="product-tag">
                            DEAL
                        </span>

                    </div>


                    <h3>
                        Mobile Accessories
                    </h3>


                    <div class="seller-line">

                        <span>
                            Local Electronics Store
                        </span>

                        <span
                            class="seller-verified"
                            title="Shopping Mela Verified"
                            onclick="
                                showSellerVerification(
                                    'Local Electronics Store'
                                )
                            "
                        >
                            ✓
                        </span>

                    </div>


                    <div class="rating">

                        ⭐ 4.5

                        <small>
                            (16 reviews)
                        </small>

                    </div>


                    <div class="market-price">

                        <strong>
                            ৳450
                        </strong>

                        <del>
                            ৳500
                        </del>

                    </div>


                    <button
                        class="add-cart-btn"
                        onclick="
                            addToCart(
                                'Mobile Accessories',
                                450
                            )
                        "
                    >
                        🛒 Add to Cart
                    </button>

                </div>

            </article>



            <!-- =================================================
                 PRODUCT 6
            ================================================== -->

            <article
                class="market-product-card"
                data-category="Home"
                data-name="
                    Home Decor
                "
                data-search="
                    home decor decoration
                    local home products
                "
                data-price="780"
                data-discount="12"
            >

                <div
                    class="market-product-image"
                    style="
                        background-image:
                        url('https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=800&q=85');
                    "
                >

                    <span class="product-discount">
                        -12%
                    </span>


                    <button
                        class="market-wishlist"
                        onclick="
                            toggleWishlist(
                                this,
                                'Home Decor'
                            )
                        "
                    >
                        ♡
                    </button>

                </div>



                <div class="market-product-info">

                    <div class="product-label-row">

                        <span class="product-tag">
                            FEATURED
                        </span>

                    </div>


                    <h3>
                        Home Decor
                    </h3>


                    <div class="seller-line">

                        <span>
                            Local Home Brand
                        </span>

                        <span
                            class="seller-verified"
                            title="Shopping Mela Verified"
                            onclick="
                                showSellerVerification(
                                    'Local Home Brand'
                                )
                            "
                        >
                            ✓
                        </span>

                    </div>


                    <div class="rating">

                        ⭐ 4.7

                        <small>
                            (9 reviews)
                        </small>

                    </div>


                    <div class="market-price">

                        <strong>
                            ৳780
                        </strong>

                        <del>
                            ৳890
                        </del>

                    </div>


                    <button
                        class="add-cart-btn"
                        onclick="
                            addToCart(
                                'Home Decor',
                                780
                            )
                        "
                    >
                        🛒 Add to Cart
                    </button>

                </div>

            </article>


        </div>



        <!-- NO RESULT -->

        <div
            class="no-product-result"
            id="noProductResult"
        >

            <div>
                🔎
            </div>

            <h3>
                কোনো Product পাওয়া যায়নি
            </h3>

            <p>
                অন্য keyword বা category
                দিয়ে চেষ্টা করুন।
            </p>

            <button
                class="secondary-btn"
                onclick="resetProducts()"
            >
                সব Products দেখুন
            </button>

        </div>

    </div>

</section>



<!-- =====================================================
     SELLER CTA
====================================================== -->

<section class="container">

    <div class="seller-cta">

        <div class="seller-cta-icon">
            🏪
        </div>


        <div>

            <small>
                FOR LOCAL SELLERS
            </small>

            <h2>
                আপনার Product Shopping Mela-তে দিন
            </h2>

            <p>
                আপনার local product ও brand
                হাজারো potential customer-এর
                সামনে তুলে ধরুন।
            </p>

        </div>


        <button
            class="primary-btn"
            onclick="
                showToast(
                    'Seller registration শীঘ্রই আসছে!'
                )
            "
        >
            Become a Seller →
        </button>

    </div>

</section>

</main>



<!-- =====================================================
     FOOTER
====================================================== -->

<footer class="footer">

    <div class="container">

        <div class="footer-main">


            <div class="footer-brand">

                <a
                    href="index.html"
                    class="logo"
                >

                    <div class="logo-icon">
                        🛍️
                    </div>

                    <span>
                        Shopping Mela
                    </span>

                </a>


                <p>
                    Local brands, products,
                    businesses, offers এবং
                    community এক জায়গায়।
                </p>

            </div>



            <div>

                <h3>
                    Shopping
                </h3>

                <a href="index.html#categories">
                    Categories
                </a>

                <a href="brands.html">
                    Local Brands
                </a>

                <a href="products.html">
                    Products
                </a>

                <a href="offers.html">
                    Offers
                </a>

            </div>



            <div>

                <h3>
                    Community
                </h3>

                <a href="blog.html">
                    Blog
                </a>

                <a href="blog.html#writePost">
                    Write a Post
                </a>

                <a href="index.html#advertise">
                    Advertise
                </a>

            </div>



            <div>

                <h3>
                    Support
                </h3>

                <a href="#">
                    About Us
                </a>

                <a href="#">
                    Contact
                </a>

                <a href="#">
                    Privacy Policy
                </a>

                <a href="#">
                    Terms
                </a>

            </div>

        </div>


        <div class="footer-bottom">

            © 2026 Shopping Mela.
            All Rights Reserved.

        </div>

    </div>

</footer>



<!-- =====================================================
     SELLER VERIFICATION MODAL
====================================================== -->

<div
    class="verification-modal"
    id="sellerVerificationModal"
    onclick="closeSellerVerificationOutside(event)"
>

    <div class="verification-modal-content">


        <button
            class="modal-close"
            onclick="closeSellerVerification()"
        >
            ×
        </button>


        <div class="verification-modal-badge">
            ✓
        </div>


        <h2>
            Verified Seller
        </h2>


        <h3 id="sellerVerificationName">
            Seller Name
        </h3>


        <p>
            এই seller-এর profile
            <strong>
                Shopping Mela
            </strong>
            দ্বারা Verified।
        </p>


        <div class="verification-check-list">

            <div>
                ✓ Seller profile reviewed
            </div>

            <div>
                ✓ Basic business information checked
            </div>

            <div>
                ✓ Verified seller badge
            </div>

        </div>


        <button
            class="primary-btn"
            onclick="closeSellerVerification()"
        >
            Done ✓
        </button>

    </div>

</div>



<!-- =====================================================
     CART MODAL
====================================================== -->

<div
    class="cart-modal"
    id="cartModal"
    onclick="closeCartOutside(event)"
>

    <div class="cart-modal-content">


        <button
            class="modal-close"
            onclick="closeCart()"
        >
            ×
        </button>


        <h2>
            🛒 Your Cart
        </h2>


        <div
            class="cart-items"
            id="cartItems"
        >
        </div>


        <div class="cart-total">

            <span>
                Total
            </span>

            <strong id="cartTotal">
                ৳0
            </strong>

        </div>


        <button
            class="primary-btn checkout-btn"
            onclick="
                showToast(
                    'Checkout system শীঘ্রই আসছে!'
                )
            "
        >
            Proceed to Checkout →
        </button>

    </div>

</div>



<!-- =====================================================
     WISHLIST MODAL
====================================================== -->

<div
    class="wishlist-modal"
    id="wishlistModal"
    onclick="closeWishlistOutside(event)"
>

    <div class="wishlist-modal-content">


        <button
            class="modal-close"
            onclick="closeWishlist()"
        >
            ×
        </button>


        <h2>
            ❤️ Wishlist
        </h2>


        <div
            id="wishlistItems"
            class="wishlist-items"
        >
        </div>

    </div>

</div>



<!-- =====================================================
     TOAST
====================================================== -->

<div
    class="toast"
    id="toast"
>
    Done!
</div>



<!-- =====================================================
     JAVASCRIPT
====================================================== -->

<script>


/* =====================================================
   DATA
====================================================== */

let cart = [];

let wishlist = [];



/* =====================================================
   TOAST
====================================================== */

function showToast(message) {

    const toast =
        document.getElementById(
            "toast"
        );


    toast.textContent =
        message;


    toast.classList.add(
        "show"
    );


    setTimeout(
        function() {

            toast.classList.remove(
                "show"
            );

        },
        2500
    );

}



/* =====================================================
   PRODUCT SEARCH
====================================================== */

function searchProducts() {

    const query =
        document
            .getElementById(
                "productSearch"
            )
            .value
            .trim()
            .toLowerCase();


    if (!query) {

        resetProducts();

        return;

    }


    const products =
        document.querySelectorAll(
            ".market-product-card"
        );


    let count = 0;


    products.forEach(
        function(product) {

            const searchable =
                (
                    product.dataset.search ||
                    ""
                ).toLowerCase();


            const name =
                (
                    product.dataset.name ||
                    ""
                ).toLowerCase();


            if (
                searchable.includes(query) ||
                name.includes(query)
            ) {

                product.style.display =
                    "";

                count++;

            } else {

                product.style.display =
                    "none";

            }

        }
    );


    updateProductCount(
        count
    );


    showNoProduct(
        count
    );


    if (count > 0) {

        showToast(
            count +
            "টি product পাওয়া গেছে 🔎"
        );

    } else {

        showToast(
            "কোনো product পাওয়া যায়নি"
        );

    }

}



/* =====================================================
   ENTER SEARCH
====================================================== */

document
    .getElementById(
        "productSearch"
    )
    .addEventListener(
        "keydown",
        function(event) {

            if (
                event.key ===
                "Enter"
            ) {

                searchProducts();

            }

        }
    );



/* =====================================================
   FILTER
====================================================== */

function filterProducts(
    category,
    button
) {

    const products =
        document.querySelectorAll(
            ".market-product-card"
        );


    document
        .querySelectorAll(
            ".product-filter"
        )
        .forEach(
            function(btn) {

                btn.classList.remove(
                    "active"
                );

            }
        );


    if (button) {

        button.classList.add(
            "active"
        );

    }


    let count = 0;


    products.forEach(
        function(product) {

            if (
                category === "all" ||
                product.dataset.category ===
                category
            ) {

                product.style.display =
                    "";

                count++;

            } else {

                product.style.display =
                    "none";

            }

        }
    );


    updateProductCount(
        count
    );


    showNoProduct(
        count
    );

}



/* =====================================================
   RESET PRODUCTS
====================================================== */

function resetProducts() {

    const products =
        document.querySelectorAll(
            ".market-product-card"
        );


    products.forEach(
        function(product) {

            product.style.display =
                "";

        }
    );


    document
        .getElementById(
            "productSearch"
        )
        .value = "";


    document
        .querySelectorAll(
            ".product-filter"
        )
        .forEach(
            function(button) {

                button.classList.remove(
                    "active"
                );

            }
        );


    const first =
        document.querySelector(
            ".product-filter"
        );


    if (first) {

        first.classList.add(
            "active"
        );

    }


    updateProductCount(
        products.length
    );


    showNoProduct(
        products.length
    );

}



/* =====================================================
   PRODUCT COUNT
====================================================== */

function updateProductCount(
    count
) {

    document
        .getElementById(
            "productResultText"
        )
        .textContent =
        count +
        "টি product পাওয়া গেছে";

}



/* =====================================================
   NO PRODUCT
====================================================== */

function showNoProduct(
    count
) {

    const box =
        document.getElementById(
            "noProductResult"
        );


    if (
        count === 0
    ) {

        box.classList.add(
            "show"
        );

    } else {

        box.classList.remove(
            "show"
        );

    }

}



/* =====================================================
   SORT MENU
====================================================== */

function toggleSortMenu() {

    const menu =
        document.getElementById(
            "sortMenu"
        );


    menu.classList.toggle(
        "show"
    );

}



/* =====================================================
   SORT PRODUCTS
====================================================== */

function sortProducts(
    type
) {

    const grid =
        document.getElementById(
            "productGrid"
        );


    const products =
        Array.from(
            grid.querySelectorAll(
                ".market-product-card"
            )
        );


    if (
        type === "low"
    ) {

        products.sort(
            function(a, b) {

                return (
                    Number(
                        a.dataset.price
                    ) -
                    Number(
                        b.dataset.price
                    )
                );

            }
        );

    }


    if (
        type === "high"
    ) {

        products.sort(
            function(a, b) {

                return (
                    Number(
                        b.dataset.price
                    ) -
                    Number(
                        a.dataset.price
                    )
                );

            }
        );

    }


    if (
        type === "discount"
    ) {

        products.sort(
            function(a, b) {

                return (
                    Number(
                        b.dataset.discount
                    ) -
                    Number(
                        a.dataset.discount
                    )
                );

            }
        );

    }


    products.forEach(
        function(product) {

            grid.appendChild(
                product
            );

        }
    );


    document
        .getElementById(
            "sortMenu"
        )
        .classList.remove(
            "show"
        );


    showToast(
        "Products sorted ✓"
    );

}



/* =====================================================
   WISHLIST
====================================================== */

function toggleWishlist(
    button,
    productName
) {

    const index =
        wishlist.indexOf(
            productName
        );


    if (
        index === -1
    ) {

        wishlist.push(
            productName
        );


        button.classList.add(
            "liked"
        );


        button.textContent =
            "♥";


        showToast(
            productName +
            " Wishlist-এ যোগ হয়েছে ❤️"
        );

    } else {

        wishlist.splice(
            index,
            1
        );


        button.classList.remove(
            "liked"
        );


        button.textContent =
            "♡";


        showToast(
            "Wishlist থেকে সরানো হয়েছে"
        );

    }


    updateWishlistCount();

}



/* =====================================================
   WISHLIST COUNT
====================================================== */

function updateWishlistCount() {

    document
        .getElementById(
            "wishlistCount"
        )
        .textContent =
        wishlist.length;

}



/* =====================================================
   OPEN WISHLIST
====================================================== */

function openWishlist() {

    const box =
        document.getElementById(
            "wishlistItems"
        );


    if (
        wishlist.length === 0
    ) {

        box.innerHTML = `
            <div class="empty-state">
                <div>♡</div>
                <h3>Wishlist খালি</h3>
                <p>আপনার পছন্দের product এখানে save করুন।</p>
            </div>
        `;

    } else {

        box.innerHTML =
            wishlist
                .map(
                    function(item) {

                        return `
                            <div class="wishlist-item">
                                <span>❤️ ${item}</span>
                                <button
                                    onclick="
                                        removeWishlist(
                                            '${item.replace(
                                                /'/g,
                                                "\\'"
                                            )}'
                                        )
                                    "
                                >
                                    Remove
                                </button>
                            </div>
                        `;

                    }
                )
                .join("");

    }


    document
        .getElementById(
            "wishlistModal"
        )
        .classList.add(
            "show"
        );

}



/* =====================================================
   REMOVE WISHLIST
====================================================== */

function removeWishlist(
    productName
) {

    wishlist =
        wishlist.filter(
            function(item) {

                return item !==
                    productName;

            }
        );


    document
        .querySelectorAll(
            ".market-wishlist"
        )
        .forEach(
            function(button) {

                if (
                    button.parentElement
                        .parentElement
                        .querySelector("h3")
                        ?.textContent
                        .trim() ===
                    productName
                ) {

                    button.classList.remove(
                        "liked"
                    );

                    button.textContent =
                        "♡";

                }

            }
        );


    updateWishlistCount();

    openWishlist();

}



/* =====================================================
   CLOSE WISHLIST
====================================================== */

function closeWishlist() {

    document
        .getElementById(
            "wishlistModal"
        )
        .classList.remove(
            "show"
        );

}



function closeWishlistOutside(
    event
) {

    if (
        event.target.id ===
        "wishlistModal"
    ) {

        closeWishlist();

    }

}



/* =====================================================
   CART
====================================================== */

function addToCart(
    productName,
    price
) {

    const existing =
        cart.find(
            function(item) {

                return item.name ===
                    productName;

            }
        );


    if (existing) {

        existing.quantity++;

    } else {

        cart.push({

            name:
                productName,

            price:
                price,

            quantity:
                1

        });

    }


    updateCartCount();

    showToast(
        productName +
        " Cart-এ যোগ হয়েছে 🛒"
    );

}



/* =====================================================
   CART COUNT
====================================================== */

function updateCartCount() {

    const count =
        cart.reduce(
            function(total, item) {

                return (
                    total +
                    item.quantity
                );

            },
            0
        );


    document
        .getElementById(
            "cartCount"
        )
        .textContent =
        count;

}



/* =====================================================
   OPEN CART
====================================================== */

function openCart() {

    const box =
        document.getElementById(
            "cartItems"
        );


    if (
        cart.length === 0
    ) {

        box.innerHTML = `
            <div class="empty-state">
                <div>🛒</div>
                <h3>Cart খালি</h3>
                <p>Product add করলে এখানে দেখা যাবে।</p>
            </div>
        `;

    } else {

        box.innerHTML =
            cart
                .map(
                    function(item, index) {

                        return `
                            <div class="cart-item">

                                <div>
                                    <strong>
                                        ${item.name}
                                    </strong>

                                    <small>
                                        ৳${item.price}
                                        ×
                                        ${item.quantity}
                                    </small>
                                </div>

                                <div>

                                    <strong>
                                        ৳${(
                                            item.price *
                                            item.quantity
                                        ).toLocaleString()}
                                    </strong>

                                    <button
                                        onclick="
                                            removeCartItem(
                                                ${index}
                                            )
                                        "
                                    >
                                        ×
                                    </button>

                                </div>

                            </div>
                        `;

                    }
                )
                .join("");

    }


    updateCartTotal();


    document
        .getElementById(
            "cartModal"
        )
        .classList.add(
            "show"
        );

}



/* =====================================================
   CART TOTAL
====================================================== */

function updateCartTotal() {

    const total =
        cart.reduce(
            function(sum, item) {

                return (
                    sum +
                    (
                        item.price *
                        item.quantity
                    )
                );

            },
            0
        );


    document
        .getElementById(
            "cartTotal"
        )
        .textContent =
        "৳" +
        total.toLocaleString();

}



/* =====================================================
   REMOVE CART ITEM
====================================================== */

function removeCartItem(
    index
) {

    cart.splice(
        index,
        1
    );


    updateCartCount();

    openCart();

}



/* =====================================================
   CLOSE CART
====================================================== */

function closeCart() {

    document
        .getElementById(
            "cartModal"
        )
        .classList.remove(
            "show"
        );

}



function closeCartOutside(
    event
) {

    if (
        event.target.id ===
        "cartModal"
    ) {

        closeCart();

    }

}



/* =====================================================
   SELLER VERIFICATION
====================================================== */

function showSellerVerification(
    sellerName
) {

    document
        .getElementById(
            "sellerVerificationName"
        )
        .textContent =
        sellerName;


    document
        .getElementById(
            "sellerVerificationModal"
        )
        .classList.add(
            "show"
        );

}



function closeSellerVerification() {

    document
        .getElementById(
            "sellerVerificationModal"
        )
        .classList.remove(
            "show"
        );

}



function closeSellerVerificationOutside(
    event
) {

    if (
        event.target.id ===
        "sellerVerificationModal"
    ) {

        closeSellerVerification();

    }

}



/* =====================================================
   ESCAPE KEY
====================================================== */

document.addEventListener(
    "keydown",
    function(event) {

        if (
            event.key ===
            "Escape"
        ) {

            closeCart();

            closeWishlist();

            closeSellerVerification();

        }

    }
);



/* =====================================================
   INITIALIZE
====================================================== */

document.addEventListener(
    "DOMContentLoaded",
    function() {

        const products =
            document.querySelectorAll(
                ".market-product-card"
            );


        updateProductCount(
            products.length
        );


        showNoProduct(
            products.length
        );


        updateCartCount();

        updateWishlistCount();

    }
);


</script>


</body>

</html>
```
