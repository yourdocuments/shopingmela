<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Product Details — Shopping Mela</title>

    <meta
        name="description"
        content="Shopping Mela Product Details"
    >

    <link
        rel="stylesheet"
        href="style.css"
    >

    <style>

        /* =====================================================
           PRODUCT PAGE
        ====================================================== */

        .product-page {
            background: #f5f6f8;
            min-height: 100vh;
            padding: 30px 0 60px;
        }


        .product-container {
            max-width: 1200px;
            margin: auto;
            padding: 0 20px;
        }


        /* =====================================================
           BREADCRUMB
        ====================================================== */

        .breadcrumb {
            margin-bottom: 20px;

            display: flex;
            align-items: center;
            gap: 8px;

            color: #667085;
            font-size: 13px;

            flex-wrap: wrap;
        }

        .breadcrumb a {
            color: #1877f2;
            text-decoration: none;
        }


        /* =====================================================
           PRODUCT MAIN CARD
        ====================================================== */

        .product-main-card {
            background: #ffffff;

            border: 1px solid #e7eaf0;

            border-radius: 18px;

            padding: 25px;

            display: grid;

            grid-template-columns:
                1fr
                1fr;

            gap: 40px;

            box-shadow:
                0 5px 20px rgba(16,24,40,.04);
        }


        /* =====================================================
           IMAGE AREA
        ====================================================== */

        .product-gallery {
            position: relative;
        }


        .main-product-image {
            height: 500px;

            border-radius: 15px;

            background-size: cover;
            background-position: center;

            position: relative;

            overflow: hidden;
        }


        .main-product-image::after {
            content: "";

            position: absolute;

            inset: 0;

            background:
                linear-gradient(
                    to top,
                    rgba(0,0,0,.08),
                    transparent 30%
                );

            pointer-events: none;
        }


        .product-badge {
            position: absolute;

            top: 18px;
            left: 18px;

            z-index: 2;

            background: #1877f2;

            color: #ffffff;

            padding: 8px 13px;

            border-radius: 8px;

            font-size: 12px;

            font-weight: 800;
        }


        .product-discount {
            position: absolute;

            top: 18px;
            right: 18px;

            z-index: 2;

            background: #ffffff;

            color: #e53935;

            padding: 8px 12px;

            border-radius: 8px;

            font-size: 13px;

            font-weight: 800;

            box-shadow:
                0 4px 12px rgba(0,0,0,.12);
        }


        .thumbnail-grid {
            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 10px;

            margin-top: 12px;
        }


        .thumbnail {
            height: 85px;

            border-radius: 10px;

            background-size: cover;
            background-position: center;

            border: 2px solid transparent;

            cursor: pointer;

            transition: .2s;
        }


        .thumbnail.active {
            border-color: #1877f2;
        }


        /* =====================================================
           PRODUCT DETAILS
        ====================================================== */

        .product-details {
            padding: 5px 0;
        }


        .product-brand-line {
            display: flex;

            align-items: center;

            gap: 5px;

            color: #1877f2;

            font-size: 14px;

            font-weight: 700;

            margin-bottom: 10px;
        }


        .mini-verified {
            width: 18px;
            height: 18px;

            background: #1877f2;

            color: #ffffff;

            border-radius: 50%;

            display: inline-flex;

            align-items: center;
            justify-content: center;

            font-size: 11px;

            font-weight: 800;
        }


        .product-title {
            margin: 0;

            color: #101828;

            font-size: 34px;

            line-height: 1.25;

            font-weight: 800;
        }


        .product-subtitle {
            color: #667085;

            margin: 12px 0 18px;

            line-height: 1.7;

            font-size: 15px;
        }


        /* =====================================================
           RATING
        ====================================================== */

        .rating-row {
            display: flex;

            align-items: center;

            gap: 12px;

            margin-bottom: 20px;
        }


        .rating-box {
            background: #1877f2;

            color: #ffffff;

            padding: 6px 10px;

            border-radius: 7px;

            font-weight: 800;

            font-size: 13px;
        }


        .rating-stars {
            color: #f59e0b;

            letter-spacing: 2px;
        }


        .rating-count {
            color: #667085;

            font-size: 13px;
        }


        /* =====================================================
           PRICE
        ====================================================== */

        .price-box {
            padding: 20px 0;

            border-top: 1px solid #eaecf0;
            border-bottom: 1px solid #eaecf0;

            margin-bottom: 20px;
        }


        .current-price {
            font-size: 34px;

            color: #111827;

            font-weight: 800;
        }


        .old-price {
            margin-left: 10px;

            color: #98a2b3;

            text-decoration: line-through;

            font-size: 17px;
        }


        .save-text {
            display: block;

            margin-top: 5px;

            color: #12b76a;

            font-size: 13px;

            font-weight: 700;
        }


        /* =====================================================
           SELLER
        ====================================================== */

        .seller-box {
            background: #f8fafc;

            border: 1px solid #e4e7ec;

            border-radius: 13px;

            padding: 16px;

            margin-bottom: 20px;
        }


        .seller-title {
            font-size: 12px;

            color: #667085;

            margin-bottom: 8px;
        }


        .seller-name {
            display: flex;

            align-items: center;

            gap: 7px;

            color: #111827;

            font-weight: 800;

            font-size: 15px;
        }


        .seller-link {
            display: inline-block;

            margin-top: 8px;

            color: #1877f2;

            font-size: 13px;

            font-weight: 700;

            text-decoration: none;
        }


        /* =====================================================
           QUANTITY
        ====================================================== */

        .quantity-area {
            display: flex;

            align-items: center;

            gap: 15px;

            margin-bottom: 18px;
        }


        .quantity-label {
            font-size: 14px;

            font-weight: 700;

            color: #344054;
        }


        .quantity-control {
            display: flex;

            align-items: center;

            border: 1px solid #d0d5dd;

            border-radius: 9px;

            overflow: hidden;
        }


        .quantity-control button {
            width: 38px;
            height: 38px;

            border: none;

            background: #ffffff;

            cursor: pointer;

            font-size: 18px;
        }


        .quantity-control span {
            width: 40px;

            text-align: center;

            font-weight: 700;
        }


        /* =====================================================
           ACTION BUTTONS
        ====================================================== */

        .product-actions {
            display: grid;

            grid-template-columns:
                1fr
                1fr;

            gap: 12px;
        }


        .product-action {
            border: none;

            padding: 15px;

            border-radius: 10px;

            font-size: 15px;

            font-weight: 800;

            cursor: pointer;

            transition: .2s;
        }


        .cart-button {
            background: #fff3d6;

            color: #a15c00;
        }


        .buy-button {
            background: #1877f2;

            color: #ffffff;
        }


        .product-action:hover {
            transform: translateY(-2px);
        }


        /* =====================================================
           FEATURE STRIP
        ====================================================== */

        .feature-strip {
            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 12px;

            margin-top: 20px;
        }


        .feature-item {
            background: #ffffff;

            border: 1px solid #e7eaf0;

            border-radius: 12px;

            padding: 16px;

            display: flex;

            gap: 10px;

            align-items: center;
        }


        .feature-icon {
            width: 40px;
            height: 40px;

            background: #eef5ff;

            border-radius: 10px;

            display: flex;

            align-items: center;
            justify-content: center;
        }


        .feature-item strong {
            display: block;

            font-size: 13px;

            color: #111827;
        }


        .feature-item span {
            color: #667085;

            font-size: 11px;
        }


        /* =====================================================
           LOWER SECTION
        ====================================================== */

        .product-lower {
            display: grid;

            grid-template-columns:
                2fr
                1fr;

            gap: 20px;

            margin-top: 20px;
        }


        .details-card {
            background: #ffffff;

            border: 1px solid #e7eaf0;

            border-radius: 16px;

            padding: 25px;
        }


        .details-card h2 {
            margin: 0 0 18px;

            color: #111827;

            font-size: 21px;
        }


        .details-card p {
            color: #667085;

            line-height: 1.8;

            font-size: 14px;
        }


        .spec-table {
            width: 100%;

            border-collapse: collapse;
        }


        .spec-table td {
            padding: 12px;

            border-bottom: 1px solid #eaecf0;

            font-size: 14px;
        }


        .spec-table td:first-child {
            width: 35%;

            color: #667085;
        }


        .spec-table td:last-child {
            color: #111827;

            font-weight: 600;
        }


        /* =====================================================
           REVIEW
        ====================================================== */

        .review-box {
            border-top: 1px solid #eaecf0;

            padding-top: 18px;

            margin-top: 18px;
        }


        .review-header {
            display: flex;

            justify-content: space-between;

            gap: 10px;

            margin-bottom: 8px;
        }


        .review-user {
            font-weight: 800;

            color: #111827;
        }


        .review-stars {
            color: #f59e0b;
        }


        .review-box p {
            margin: 0;

            font-size: 13px;
        }


        /* =====================================================
           RELATED PRODUCTS
        ====================================================== */

        .related-section {
            margin-top: 30px;
        }


        .related-section h2 {
            color: #111827;

            margin-bottom: 18px;
        }


        .related-grid {
            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 16px;
        }


        .related-card {
            background: #ffffff;

            border: 1px solid #e7eaf0;

            border-radius: 14px;

            overflow: hidden;

            cursor: pointer;

            transition: .2s;
        }


        .related-card:hover {
            transform: translateY(-3px);

            box-shadow:
                0 8px 20px rgba(16,24,40,.08);
        }


        .related-image {
            height: 190px;

            background-size: cover;

            background-position: center;
        }


        .related-info {
            padding: 14px;
        }


        .related-info h3 {
            margin: 0 0 7px;

            font-size: 14px;

            color: #111827;
        }


        .related-info strong {
            color: #1877f2;

            font-size: 17px;
        }


        /* =====================================================
           TOAST
        ====================================================== */

        .product-toast {
            position: fixed;

            left: 50%;
            bottom: 25px;

            transform:
                translate(-50%, 100px);

            background: #111827;

            color: #ffffff;

            padding: 13px 20px;

            border-radius: 10px;

            z-index: 9999;

            opacity: 0;

            transition: .3s;

            font-size: 14px;

            box-shadow:
                0 10px 30px rgba(0,0,0,.2);
        }


        .product-toast.show {
            opacity: 1;

            transform:
                translate(-50%, 0);
        }


        /* =====================================================
           RESPONSIVE
        ====================================================== */

        @media (max-width: 900px) {

            .product-main-card {
                grid-template-columns: 1fr;
            }

            .product-lower {
                grid-template-columns: 1fr;
            }

            .related-grid {
                grid-template-columns:
                    repeat(2, 1fr);
            }

        }


        @media (max-width: 600px) {

            .product-page {
                padding-top: 15px;
            }

            .product-main-card {
                padding: 15px;

                gap: 20px;
            }

            .main-product-image {
                height: 350px;
            }

            .product-title {
                font-size: 26px;
            }

            .current-price {
                font-size: 28px;
            }

            .feature-strip {
                grid-template-columns: 1fr;
            }

            .product-actions {
                grid-template-columns: 1fr;
            }

            .related-grid {
                grid-template-columns: 1fr;
            }

            .thumbnail {
                height: 65px;
            }

        }

    </style>

</head>


<body>


<!-- =====================================================
     TOP BAR
====================================================== -->

<div class="top-bar">

    🛍️ <span>Shopping Mela</span>
    — Product Details

</div>



<!-- =====================================================
     HEADER
====================================================== -->

<header class="header">

    <div class="container">

        <div class="header-main">


            <!-- LOGO -->

            <a
                href="index.html"
                class="logo"
            >

                <div class="logo-icon">
                    🛍️
                </div>

                <span>
                    Shopping Mela
                </span>

            </a>



            <!-- SEARCH -->

            <div class="header-search">

                <input
                    type="search"
                    id="productSearch"
                    placeholder="পণ্য, ব্র্যান্ড বা দোকান খুঁজুন..."
                >

                <button
                    type="button"
                    onclick="searchProduct()"
                >
                    🔍
                </button>

            </div>



            <!-- ACTIONS -->

            <div class="header-actions">

                <button
                    class="header-action"
                    onclick="showProductToast('Wishlist শীঘ্রই আসছে ❤️')"
                >

                    <span class="header-action-icon">
                        ♡
                    </span>

                    <span>
                        Wishlist
                    </span>

                </button>


                <button
                    class="header-action"
                    onclick="showProductToast('Cart শীঘ্রই আসছে 🛒')"
                >

                    <span class="header-action-icon">
                        🛒
                    </span>

                    <span>
                        Cart
                    </span>

                </button>

            </div>

        </div>



        <!-- NAVIGATION -->

        <nav class="navigation">

            <div class="navigation-inner">

                <a href="index.html">
                    Home
                </a>

                <a href="index.html#categories">
                    Categories
                </a>

                <a href="index.html#brands">
                    Local Brands
                </a>

                <a
                    href="index.html#products"
                    class="active"
                >
                    Products
                </a>

                <a href="index.html#offers">
                    Offers
                </a>

                <a href="blog.html">
                    Blog
                </a>

                <a href="index.html#advertise">
                    Advertise With Us
                </a>

            </div>

        </nav>

    </div>

</header>



<!-- =====================================================
     MAIN
====================================================== -->

<main class="product-page">

    <div class="product-container">


        <!-- =================================================
             BREADCRUMB
        ================================================== -->

        <div class="breadcrumb">

            <a href="index.html">
                Home
            </a>

            <span>›</span>

            <a href="index.html#categories">
                Fashion
            </a>

            <span>›</span>

            <span>
                Ladies Three Piece
            </span>

        </div>



        <!-- =================================================
             PRODUCT MAIN
        ================================================== -->

        <section class="product-main-card">


            <!-- =================================================
                 GALLERY
            ================================================== -->

            <div class="product-gallery">


                <div
                    class="main-product-image"
                    id="mainProductImage"
                    style="
                        background-image:
                        url('https://images.unsplash.com/photo-1594633312681-425c7b97ccd1?auto=format&fit=crop&w=1000&q=85');
                    "
                >

                    <span class="product-badge">
                        FEATURED
                    </span>


                    <span class="product-discount">
                        20% OFF
                    </span>

                </div>



                <div class="thumbnail-grid">


                    <div
                        class="thumbnail active"
                        style="
                            background-image:
                            url('https://images.unsplash.com/photo-1594633312681-425c7b97ccd1?auto=format&fit=crop&w=500&q=80');
                        "
                        onclick="changeProductImage(this)"
                    ></div>


                    <div
                        class="thumbnail"
                        style="
                            background-image:
                            url('https://images.unsplash.com/photo-1485968579580-b6d095142e6e?auto=format&fit=crop&w=500&q=80');
                        "
                        onclick="changeProductImage(this)"
                    ></div>


                    <div
                        class="thumbnail"
                        style="
                            background-image:
                            url('https://images.unsplash.com/photo-1496747611176-843222e1e57c?auto=format&fit=crop&w=500&q=80');
                        "
                        onclick="changeProductImage(this)"
                    ></div>


                    <div
                        class="thumbnail"
                        style="
                            background-image:
                            url('https://images.unsplash.com/photo-1551488831-00ddcb6c6bd3?auto=format&fit=crop&w=500&q=80');
                        "
                        onclick="changeProductImage(this)"
                    ></div>

                </div>

            </div>



            <!-- =================================================
                 DETAILS
            ================================================== -->

            <div class="product-details">


                <div class="product-brand-line">

                    Anjona Ladies Tailors

                    <span
                        class="mini-verified"
                        title="Verified Business"
                    >
                        ✓
                    </span>

                </div>



                <h1 class="product-title">

                    Ladies Three Piece

                </h1>



                <p class="product-subtitle">

                    সুন্দর ও আধুনিক ladies three-piece
                    collection। Local fashion brand-এর
                    premium quality design।

                </p>



                <!-- RATING -->

                <div class="rating-row">

                    <span class="rating-box">
                        4.9 ★
                    </span>

                    <span class="rating-stars">
                        ★★★★★
                    </span>

                    <span class="rating-count">
                        128 Reviews
                    </span>

                </div>



                <!-- PRICE -->

                <div class="price-box">

                    <span class="current-price">
                        ৳1,250
                    </span>

                    <span class="old-price">
                        ৳1,550
                    </span>

                    <span class="save-text">
                        Save ৳300
                    </span>

                </div>



                <!-- SELLER -->

                <div class="seller-box">

                    <div class="seller-title">
                        SOLD BY
                    </div>

                    <div class="seller-name">

                        Anjona Ladies Tailors

                        <span
                            class="mini-verified"
                        >
                            ✓
                        </span>

                    </div>

                    <a
                        href="profile.html"
                        class="seller-link"
                    >
                        View Verified Profile →
                    </a>

                </div>



                <!-- QUANTITY -->

                <div class="quantity-area">

                    <span class="quantity-label">
                        Quantity
                    </span>

                    <div class="quantity-control">

                        <button
                            onclick="decreaseQuantity()"
                        >
                            −
                        </button>

                        <span id="quantity">
                            1
                        </span>

                        <button
                            onclick="increaseQuantity()"
                        >
                            +
                        </button>

                    </div>

                </div>



                <!-- ACTIONS -->

                <div class="product-actions">

                    <button
                        class="product-action cart-button"
                        onclick="addToCart()"
                    >
                        🛒 Add to Cart
                    </button>


                    <button
                        class="product-action buy-button"
                        onclick="buyNow()"
                    >
                        ⚡ Buy Now
                    </button>

                </div>

            </div>

        </section>



        <!-- =================================================
             FEATURES
        ================================================== -->

        <div class="feature-strip">


            <div class="feature-item">

                <div class="feature-icon">
                    🚚
                </div>

                <div>

                    <strong>
                        Local Delivery
                    </strong>

                    <span>
                        Nearby delivery available
                    </span>

                </div>

            </div>


            <div class="feature-item">

                <div class="feature-icon">
                    ✓
                </div>

                <div>

                    <strong>
                        Verified Seller
                    </strong>

                    <span>
                        Shopping Mela verified
                    </span>

                </div>

            </div>


            <div class="feature-item">

                <div class="feature-icon">
                    🔒
                </div>

                <div>

                    <strong>
                        Secure Shopping
                    </strong>

                    <span>
                        Safe order process
                    </span>

                </div>

            </div>

        </div>



        <!-- =================================================
             LOWER DETAILS
        ================================================== -->

        <section class="product-lower">


            <!-- LEFT -->

            <div>


                <div class="details-card">

                    <h2>
                        Product Description
                    </h2>

                    <p>

                        এই সুন্দর ladies three-piece
                        collectionটি local fashion
                        customers-এর জন্য তৈরি।

                        <br><br>

                        Dress-এর design, fabric এবং
                        tailoring customization-এর
                        সুযোগ থাকতে পারে। Order করার
                        আগে seller-এর সঙ্গে available
                        size ও color সম্পর্কে যোগাযোগ
                        করে নিতে পারেন।

                    </p>

                </div>



                <div
                    class="details-card"
                    style="margin-top:20px;"
                >

                    <h2>
                        Product Information
                    </h2>


                    <table class="spec-table">

                        <tr>

                            <td>
                                Category
                            </td>

                            <td>
                                Fashion
                            </td>

                        </tr>


                        <tr>

                            <td>
                                Product Type
                            </td>

                            <td>
                                Ladies Three Piece
                            </td>

                        </tr>


                        <tr>

                            <td>
                                Seller
                            </td>

                            <td>
                                Anjona Ladies Tailors
                            </td>

                        </tr>


                        <tr>

                            <td>
                                Availability
                            </td>

                            <td>
                                Available
                            </td>

                        </tr>


                        <tr>

                            <td>
                                Seller Status
                            </td>

                            <td>
                                ✓ Verified Business
                            </td>

                        </tr>

                    </table>

                </div>



                <!-- REVIEWS -->

                <div
                    class="details-card"
                    style="margin-top:20px;"
                >

                    <h2>
                        Customer Reviews
                    </h2>


                    <div class="review-box">

                        <div class="review-header">

                            <span class="review-user">
                                Rahima
                            </span>

                            <span class="review-stars">
                                ★★★★★
                            </span>

                        </div>

                        <p>
                            Product quality ভালো এবং
                            design অনেক সুন্দর।
                        </p>

                    </div>


                    <div class="review-box">

                        <div class="review-header">

                            <span class="review-user">
                                Nusrat
                            </span>

                            <span class="review-stars">
                                ★★★★★
                            </span>

                        </div>

                        <p>
                            Local seller হিসেবে service
                            ভালো পেয়েছি।
                        </p>

                    </div>

                </div>

            </div>



            <!-- RIGHT -->

            <div>

                <div class="details-card">

                    <h2>
                        Seller Information
                    </h2>


                    <div class="seller-box">

                        <div class="seller-name">

                            👗 Anjona Ladies Tailors

