<!-- =====================================================
     JAVASCRIPT
====================================================== -->

<script src="script.js"></script>


<script>

let activeProductFilter = "all";



/* =====================================================
   PRODUCT FILTER
====================================================== */

function filterProducts() {

    const search =
        document
            .getElementById(
                "productSearch"
            )
            .value
            .trim()
            .toLowerCase();


    const cards =
        document.querySelectorAll(
            "#productsGrid .product-card"
        );


    const empty =
        document.getElementById(
            "emptyProducts"
        );


    const count =
        document.getElementById(
            "productsCount"
        );


    let visible = 0;


    cards.forEach(
        function(card) {

            const name =
                (
                    card.dataset.name ||
                    ""
                ).toLowerCase();


            const category =
                (
                    card.dataset.category ||
                    ""
                ).toLowerCase();


            const seller =
                (
                    card.dataset.seller ||
                    ""
                ).toLowerCase();


            const matchesSearch =
                !search ||
                name.includes(search) ||
                category.includes(search) ||
                seller.includes(search);


            const matchesFilter =
                activeProductFilter === "all" ||
                category.includes(
                    activeProductFilter
                );


            if (
                matchesSearch &&
                matchesFilter
            ) {

                card.classList.remove(
                    "hidden"
                );

                visible++;

            } else {

                card.classList.add(
                    "hidden"
                );

            }

        }
    );


    count.textContent =
        visible +
        "টি Product দেখানো হচ্ছে";


    if (visible === 0) {

        empty.classList.add(
            "show"
        );

    } else {

        empty.classList.remove(
            "show"
        );

    }

}



/* =====================================================
   CATEGORY FILTER
====================================================== */

function setProductFilter(
    filter,
    button
) {

    activeProductFilter =
        filter;


    document
        .querySelectorAll(
            ".product-filter"
        )
        .forEach(
            function(item) {

                item.classList.remove(
                    "active"
                );

            }
        );


    button.classList.add(
        "active"
    );


    filterProducts();

}



/* =====================================================
   SEARCH ENTER
====================================================== */

document
    .getElementById(
        "productSearch"
    )
    .addEventListener(
        "keydown",
        function(event) {

            if (
                event.key === "Enter"
            ) {

                filterProducts();

            }

        }
    );



/* =====================================================
   GLOBAL SEARCH
====================================================== */

function globalProductSearch() {

    const input =
        document.getElementById(
            "globalProductSearch"
        );


    const value =
        input.value.trim();


    if (!value) {

        input.focus();

        return;

    }


    const productSearch =
        document.getElementById(
            "productSearch"
        );


    productSearch.value =
        value;


    filterProducts();


    document
        .getElementById(
            "productsGrid"
        )
        .scrollIntoView({
            behavior: "smooth"
        });

}



/* =====================================================
   WISHLIST
====================================================== */

function addWishlist(button) {

    if (
        button.classList.contains(
            "liked"
        )
    ) {

        button.classList.remove(
            "liked"
        );

        button.textContent = "♡";

        if (
            typeof showToast ===
            "function"
        ) {

            showToast(
                "Wishlist থেকে সরানো হয়েছে"
            );

        }

        return;

    }


    button.classList.add(
        "liked"
    );

    button.textContent = "♥";


    if (
        typeof showToast ===
        "function"
    ) {

        showToast(
            "Wishlist-এ যোগ করা হয়েছে ❤️"
        );

    }

}



/* =====================================================
   PRODUCT VIEW
====================================================== */

function viewProduct(
    productName
) {

    if (
        typeof showToast ===
        "function"
    ) {

        showToast(
            productName +
            " details শীঘ্রই আসছে!"
        );

    } else {

        alert(
            productName +
            " details শীঘ্রই আসছে!"
        );

    }

}



/* =====================================================
   INITIAL LOAD
====================================================== */

filterProducts();

</script>



</body>

</html>
```
