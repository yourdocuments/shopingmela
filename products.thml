<!DOCTYPE html>
<html lang="bn">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Products — Shopping Mela
    </title>

    <meta
        name="description"
        content="Shopping Mela — Local sellers-এর products, deals এবং verified brands."
    >

    <link
        rel="stylesheet"
        href="style.css"
    >

</head>


<body>


<!-- =====================================================
     TOP BAR
====================================================== -->

<div class="top-bar">

    🛍️

    <span>
        Shopping Mela
    </span>

    — Local Products & Brands এক জায়গায়

</div>



<!-- =====================================================
     HEADER
====================================================== -->

<header class="header">

    <div class="container">

        <div class="header-main">


            <!-- LOGO -->

            <a
                href="index.html"
                class="logo"
            >

                <div class="logo-icon">
                    🛍️
                </div>

                <span>
                    Shopping Mela
                </span>

            </a>



            <!-- SEARCH -->

            <div class="header-search">

                <input
                    type="search"
                    id="productSearch"
                    placeholder="Product, brand বা category খুঁজুন..."
                    aria-label="Search products"
                >

                <button
                    type="button"
                    onclick="searchProducts()"
                    aria-label="Search"
                >
                    🔍
                </button>

            </div>



            <!-- HEADER ACTIONS -->

            <div class="header-actions">

                <button
                    class="header-action"
                    type="button"
                    onclick="showWishlist()"
                >

                    <span class="header-action-icon">
                        ♡
                    </span>

                    <span>
                        Wishlist
                    </span>

                </button>


                <button
                    class="header-action"
                    type="button"
                    onclick="showCart()"
