<!-- =====================================================
     JAVASCRIPT
====================================================== -->

<script>


/* =====================================================
   GLOBAL DATA
====================================================== */

let cartItems = 0;

let wishlistItems = 0;



/* =====================================================
   TOAST
====================================================== */

function showToast(message) {

    const toast =
        document.getElementById(
            "toast"
        );


    toast.textContent =
        message;


    toast.classList.add(
        "show"
    );


    setTimeout(function() {

        toast.classList.remove(
            "show"
        );

    }, 2500);

}



/* =====================================================
   FILTER PRODUCTS
====================================================== */

function filterProducts(
    category,
    button
) {

    const products =
        document.querySelectorAll(
            ".marketplace-product"
        );


    document
        .querySelectorAll(
            ".product-filter"
        )
        .forEach(function(btn) {

            btn.classList.remove(
                "active"
            );

        });


    if (button) {

        button.classList.add(
            "active"
        );

    }


    let count = 0;


    products.forEach(function(product) {

        const productCategory =
            product.dataset.category;


        if (
            category === "all" ||
            productCategory === category
        ) {

            product.style.display =
                "";

            count++;

        } else {

            product.style.display =
                "none";

        }

    });


    updateProductResult(
        count
    );


    showProductNoResult(
        count
    );

}



/* =====================================================
   SEARCH PRODUCTS
====================================================== */

function searchProducts() {

    const input =
        document.getElementById(
            "productSearch"
        );


    const query =
        input.value
            .trim()
            .toLowerCase();


    if (!query) {

        resetProducts();

        return;

    }


    const products =
        document.querySelectorAll(
            ".marketplace-product"
        );


    let count = 0;


    products.forEach(function(product) {

        const productText =
            (
                product.dataset.product ||
                ""
            ).toLowerCase();


        const visibleText =
            product.innerText.toLowerCase();


        if (
            productText.includes(query) ||
            visibleText.includes(query)
        ) {

            product.style.display =
                "";

            count++;

        } else {

            product.style.display =
                "none";

        }

    });


    document
        .querySelectorAll(
            ".product-filter"
        )
        .forEach(function(btn) {

            btn.classList.remove(
                "active"
            );

        });


    updateProductResult(
        count
    );


    showProductNoResult(
        count
    );


    if (count > 0) {

        showToast(
            count +
            "টি Product পাওয়া গেছে 🔎"
        );

    } else {

        showToast(
            "কোনো Product পাওয়া যায়নি"
        );

    }

}



/* =====================================================
   ENTER SEARCH
====================================================== */

document
    .getElementById(
        "productSearch"
    )
    .addEventListener(
        "keydown",
        function(event) {

            if (
                event.key === "Enter"
            ) {

                searchProducts();

            }

        }
    );



/* =====================================================
   SORT PRODUCTS
====================================================== */

function sortProducts() {

    const grid =
        document.getElementById(
            "productGrid"
        );


    const select =
        document.getElementById(
            "sortProducts"
        );


    const value =
        select.value;


    const products =
        Array.from(
            grid.querySelectorAll(
                ".marketplace-product"
            )
        );


    products.sort(
        function(a, b) {

            const priceA =
                Number(
                    a.dataset.price
                );


            const priceB =
                Number(
                    b.dataset.price
                );


            const discountA =
                Number(
                    a.dataset.discount
                );


            const discountB =
                Number(
                    b.dataset.discount
                );


            if (
                value === "low"
            ) {

                return priceA - priceB;

            }


            if (
                value === "high"
            ) {

                return priceB - priceA;

            }


            if (
                value === "discount"
            ) {

                return discountB - discountA;

            }


            return 0;

        }
    );


    products.forEach(
        function(product) {

            grid.appendChild(
                product
            );

        }
    );


    showToast(
        "Products sorted ✓"
    );

}



/* =====================================================
   ADD TO CART
====================================================== */

function addToCart(
    productName,
    price
) {

    cartItems++;


    document
        .getElementById(
            "cartCount"
        )
        .textContent =
        cartItems;


    showToast(
        productName +
        " Cart-এ যোগ হয়েছে 🛒"
    );

}



/* =====================================================
   CART
====================================================== */

function showCart() {

    if (
        cartItems === 0
    ) {

        showToast(
            "আপনার Cart এখনো খালি 🛒"
        );

        return;

    }


    showToast(
        "Cart-এ " +
        cartItems +
        "টি item আছে 🛒"
    );

}



/* =====================================================
   WISHLIST
====================================================== */

function toggleWishlist(
    button,
    productName
) {

    const active =
        button.classList.toggle(
            "active"
        );


    if (active) {

        wishlistItems++;


        button.textContent =
            "♥";


        showToast(
            productName +
            " Wishlist-এ যোগ হয়েছে ❤️"
        );

    } else {

        wishlistItems--;


        button.textContent =
            "♡";


        showToast(
            productName +
            " Wishlist থেকে সরানো হয়েছে"
        );

    }

}



/* =====================================================
   WISHLIST HEADER
====================================================== */

function showWishlist() {

    if (
        wishlistItems === 0
    ) {

        showToast(
            "আপনার Wishlist এখনো খালি ❤️"
        );

        return;

    }


    showToast(
        "Wishlist-এ " +
        wishlistItems +
        "টি item আছে ❤️"
    );

}



/* =====================================================
   RESULT TEXT
====================================================== */

function updateProductResult(
    count
) {

    document
        .getElementById(
            "productResultText"
        )
        .textContent =
        count +
        "টি Product পাওয়া গেছে";

}



/* =====================================================
   NO RESULT
====================================================== */

function showProductNoResult(
    count
) {

    const box =
        document.getElementById(
            "noProductResult"
        );


    if (
        count === 0
    ) {

        box.classList.add(
            "show"
        );

    } else {

        box.classList.remove(
            "show"
        );

    }

}



/* =====================================================
   RESET PRODUCTS
====================================================== */

function resetProducts() {

    const products =
        document.querySelectorAll(
            ".marketplace-product"
        );


    products.forEach(function(product) {

        product.style.display =
            "";

    });


    document
        .getElementById(
            "productSearch"
        )
        .value = "";


    document
        .querySelectorAll(
            ".product-filter"
        )
        .forEach(function(btn) {

            btn.classList.remove(
                "active"
            );

        });


    const allButton =
        document.querySelector(
            ".product-filter"
        );


    if (allButton) {

        allButton.classList.add(
            "active"
        );

    }


    updateProductResult(
        products.length
    );


    showProductNoResult(
        products.length
    );

}



/* =====================================================
   INITIALIZE
====================================================== */

document.addEventListener(
    "DOMContentLoaded",
    function() {

        const products =
            document.querySelectorAll(
                ".marketplace-product"
            );


        updateProductResult(
            products.length
        );

    }
);


</script>


</body>

</html>
```
