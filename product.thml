                    Contact
                </a>

                <a href="#">
                    Privacy Policy
                </a>

                <a href="#">
                    Terms
                </a>

            </div>

        </div>


        <div class="footer-bottom">

            © 2026 Shopping Mela.
            All Rights Reserved.

        </div>

    </div>

</footer>



<!-- =====================================================
     TOAST
====================================================== -->

<div
    class="toast"
    id="toast"
>
    Done!
</div>



<!-- =====================================================
     JAVASCRIPT
====================================================== -->

<script>


/* =====================================================
   TOAST
====================================================== */

function showToast(message) {

    const toast =
        document.getElementById(
            "toast"
        );


    toast.textContent =
        message;


    toast.classList.add(
        "show"
    );


    setTimeout(function() {

        toast.classList.remove(
            "show"
        );

    }, 2500);

}



/* =====================================================
   FILTER PRODUCTS
====================================================== */

function filterProducts(
    category,
    button
) {

    const products =
        document.querySelectorAll(
            ".marketplace-product-card"
        );


    document
        .querySelectorAll(
            ".product-filter"
        )
        .forEach(function(btn) {

            btn.classList.remove(
                "active"
            );

        });


    if (button) {

        button.classList.add(
            "active"
        );

    }


    let count = 0;


    products.forEach(function(product) {

        const productCategory =
            product.dataset.category;


        if (
            category === "all" ||
            productCategory === category
        ) {

            product.style.display =
                "";

            count++;

        } else {

            product.style.display =
                "none";

        }

    });


    updateProductResult(
        count
    );


    showProductNoResult(
        count
    );

}



/* =====================================================
   SEARCH PRODUCTS
====================================================== */

function searchProducts() {

    const input =
        document.getElementById(
            "productSearch"
        );


    const query =
        input.value
            .trim()
            .toLowerCase();


    if (!query) {

        resetProducts();

        return;

    }


    document
        .querySelectorAll(
            ".product-filter"
        )
        .forEach(function(btn) {

            btn.classList.remove(
                "active"
            );

        });


    const products =
        document.querySelectorAll(
            ".marketplace-product-card"
        );


    let count = 0;


    products.forEach(function(product) {

        const name =
            (
                product.dataset.product ||
                ""
            ).toLowerCase();


        const category =
            (
                product.dataset.category ||
                ""
            ).toLowerCase();


        const text =
            product.innerText.toLowerCase();


        if (
            name.includes(query) ||
            category.includes(query) ||
            text.includes(query)
        ) {

            product.style.display =
                "";

            count++;

        } else {

            product.style.display =
                "none";

        }

    });


    updateProductResult(
        count
    );


    showProductNoResult(
        count
    );


    if (count > 0) {

        showToast(
            count +
            "টি Product পাওয়া গেছে 🔎"
        );

    } else {

        showToast(
            "কোনো Product পাওয়া যায়নি"
        );

    }

}



/* =====================================================
   ENTER SEARCH
====================================================== */

document
    .getElementById(
        "productSearch"
    )
    .addEventListener(
        "keydown",
        function(event) {

            if (
                event.key === "Enter"
            ) {

                searchProducts();

            }

        }
    );



/* =====================================================
   SORT PRODUCTS
====================================================== */

function sortProducts() {

    const grid =
        document.getElementById(
            "productGrid"
        );


    const products =
        Array.from(
            grid.querySelectorAll(
                ".marketplace-product-card"
            )
        );


    const sortValue =
        document
            .getElementById(
                "sortProducts"
            )
            .value;


    if (
        sortValue === "low"
    ) {

        products.sort(function(a, b) {

            return (
                Number(a.dataset.price) -
                Number(b.dataset.price)
            );

        });

    }


    else if (
        sortValue === "high"
    ) {

        products.sort(function(a, b) {

            return (
                Number(b.dataset.price) -
                Number(a.dataset.price)
            );

        });

    }


    else if (
        sortValue === "name"
    ) {

        products.sort(function(a, b) {

            return (
                a.dataset.product
                    .localeCompare(
                        b.dataset.product
                    )
            );

        });

    }


    products.forEach(function(product) {

        grid.appendChild(
            product
        );

    });


    showToast(
        "Products sorted successfully ✓"
    );

}



/* =====================================================
   WISHLIST
====================================================== */

function toggleWishlist(
    button
) {

    button.classList.toggle(
        "liked"
    );


    if (
        button.classList.contains(
            "liked"
        )
    ) {

        button.innerHTML =
            "♥";

        showToast(
            "Wishlist-এ যোগ করা হয়েছে ❤️"
        );

    } else {

        button.innerHTML =
            "♡";

        showToast(
            "Wishlist থেকে সরানো হয়েছে"
        );

    }

}



/* =====================================================
   CART
====================================================== */

function addToCart(
    productName
) {

    showToast(
        productName +
        " Cart-এ যোগ করা হয়েছে 🛒"
    );

}



/* =====================================================
   RESULT TEXT
====================================================== */

function updateProductResult(
    count
) {

    document
        .getElementById(
            "productResultText"
        )
        .textContent =
        count +
        "টি Product পাওয়া গেছে";

}



/* =====================================================
   NO RESULT
====================================================== */

function showProductNoResult(
    count
) {

    const noResult =
        document.getElementById(
            "noProductResult"
        );


    if (
        count === 0
    ) {

        noResult.classList.add(
            "show"
        );

    } else {

        noResult.classList.remove(
            "show"
        );

    }

}



/* =====================================================
   RESET PRODUCTS
====================================================== */

function resetProducts() {

    const products =
        document.querySelectorAll(
            ".marketplace-product-card"
        );


    products.forEach(function(product) {

        product.style.display =
            "";

    });


    document
        .getElementById(
            "productSearch"
        )
        .value = "";


    document
        .getElementById(
            "sortProducts"
        )
        .value = "default";


    document
        .querySelectorAll(
            ".product-filter"
        )
        .forEach(function(btn) {

            btn.classList.remove(
                "active"
            );

        });


    const allButton =
        document.querySelector(
            ".product-filter"
        );


    if (allButton) {

        allButton.classList.add(
            "active"
        );

    }


    const total =
        products.length;


    updateProductResult(
        total
    );


    showProductNoResult(
        total
    );

}



/* =====================================================
   VERIFICATION MODAL
====================================================== */

function showVerificationInfo() {

    document
        .getElementById(
            "verificationModal"
        )
        .classList.add(
            "show"
        );

}


function closeVerificationInfo() {

    document
        .getElementById(
            "verificationModal"
        )
        .classList.remove(
            "show"
        );

}



/* =====================================================
   ESC KEY
====================================================== */

document.addEventListener(
    "keydown",
    function(event) {

        if (
            event.key === "Escape"
        ) {

            closeVerificationInfo();

        }

    }
);



/* =====================================================
   INITIALIZE
====================================================== */

document.addEventListener(
    "DOMContentLoaded",
    function() {

        const products =
            document.querySelectorAll(
                ".marketplace-product-card"
            );


        updateProductResult(
            products.length
        );

    }
);


</script>


</body>

</html>
```
