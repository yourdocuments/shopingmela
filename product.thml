</section>



<!-- =====================================================
     VERIFIED SELLER INFO
====================================================== -->

<section class="container">

    <div class="verified-banner">

        <div class="verified-banner-icon">
            ✓
        </div>


        <div>

            <h2>
                🔵 Verified Seller
            </h2>

            <p>
                Blue verified badge থাকা seller/profile-গুলো
                Shopping Mela verification process-এর মাধ্যমে
                verified হিসেবে চিহ্নিত।
            </p>

        </div>


        <button
            class="secondary-btn"
            onclick="showVerificationInfo()"
        >
            বিস্তারিত
        </button>

    </div>

</section>



<!-- =====================================================
     SELL ON SHOPPING MELA
====================================================== -->

<section class="container">

    <div class="advertise-section">

        <div class="advertise-text">

            <small>
                🛍️ FOR LOCAL SELLERS
            </small>

            <h2>
                আপনার Product
                Shopping Mela-তে দিন
            </h2>

            <p>
                Local customers-এর কাছে আপনার products
                ও brand প্রচার করুন।
            </p>

        </div>


        <button
            class="advertise-button"
            onclick="
                window.location.href='index.html#advertise'
            "
        >
            Seller / Advertise করুন →
        </button>

    </div>

</section>


</main>



<!-- =====================================================
     VERIFICATION MODAL
====================================================== -->

<div
    class="modal"
    id="verificationModal"
>

    <div
        class="modal-overlay"
        onclick="closeVerificationInfo()"
    >
    </div>


    <div class="modal-box">

        <button
            class="modal-close"
            onclick="closeVerificationInfo()"
        >
            ×
        </button>


        <div class="verification-modal-icon">
            ✓
        </div>


        <h2>
            🔵 Verified Seller
        </h2>


        <p>
            Verified badge থাকা seller বা brand profile
            Shopping Mela-তে verified হিসেবে চিহ্নিত।
        </p>


        <p>
            এই badge profile-এর authenticity ও
            platform verification status বোঝাতে ব্যবহার করা হয়।
        </p>


        <button
            class="primary-btn"
            onclick="closeVerificationInfo()"
        >
            বুঝেছি
        </button>

    </div>

</div>



