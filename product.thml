<!DOCTYPE html>
<html lang="bn">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Products — Shopping Mela
    </title>

    <meta
        name="description"
        content="Shopping Mela — Local products, brands, offers and verified sellers."
    >

    <link
        rel="stylesheet"
        href="style.css"
    >

</head>


<body>


<!-- =====================================================
     TOP BAR
====================================================== -->

<div class="top-bar">

    🛍️

    <span>
        Shopping Mela
    </span>

    — Local Products & Verified Brands

</div>



<!-- =====================================================
     HEADER
====================================================== -->

<header class="header">

    <div class="container">

        <div class="header-main">


            <!-- LOGO -->

            <a
                href="index.html"
                class="logo"
            >

                <div class="logo-icon">
                    🛍️
                </div>

                <span>
                    Shopping Mela
                </span>

            </a>



            <!-- SEARCH -->

            <div class="header-search">

                <input
                    type="search"
                    id="productSearch"
                    placeholder="পণ্য, brand বা category খুঁজুন..."
                    aria-label="Search products"
                >

                <button
                    type="button"
                    onclick="searchProducts()"
                    aria-label="Search"
                >
                    🔍
                </button>

            </div>



            <!-- ACTIONS -->

            <div class="header-actions">

                <button
                    class="header-action"
                    onclick="
                        showToast('Wishlist শীঘ্রই আসছে ❤️')
                    "
                >

                    <span class="header-action-icon">
                        ♡
                    </span>

                    <span>
                        Wishlist
                    </span>

                </button>


                <button
                    class="header-action"
                    onclick="
                        showToast('Shopping Cart শীঘ্রই আসছে 🛒')
                    "
                >

                    <span class="header-action-icon">
                        🛒
                    </span>

                    <span>
                        Cart
                    </span>

                </button>

            </div>

        </div>



        <!-- NAVIGATION -->

        <nav class="navigation">

            <div class="navigation-inner">

                <a href="index.html">
                    Home
                </a>

                <a href="index.html#categories">
                    Categories
                </a>

                <a href="brands.html">
                    Local Brands
                </a>

                <a
                    href="products.html"
                    class="active"
                >
                    Products
                </a>

                <a href="index.html#offers">
                    Offers
                </a>

                <a href="blog.html">
                    Blog
                </a>

                <a href="index.html#advertise">
                    Advertise With Us
                </a>

            </div>

        </nav>

    </div>

</header>



<main>



<!-- =====================================================
     PRODUCTS HERO
====================================================== -->

<section class="products-page-hero">

    <div class="container">

        <div class="products-hero-content">

            <span class="page-label">
                🛒 SHOPPING MELA MARKETPLACE
            </span>

            <h1>
                Local Products
                এক জায়গায়
            </h1>

            <p>
                আপনার এলাকার local brand ও verified seller-এর
                জনপ্রিয় products খুঁজে নিন।
            </p>


            <div class="products-hero-actions">

                <button
                    class="primary-btn"
                    onclick="
                        document
                        .getElementById('productArea')
                        .scrollIntoView({
                            behavior:'smooth'
                        })
                    "
                >
                    Products দেখুন →
                </button>


                <button
                    class="light-btn"
                    onclick="
                        window.location.href='brands.html'
                    "
                >
                    Brands দেখুন
                </button>

            </div>

        </div>

    </div>

</section>



<!-- =====================================================
     PRODUCT AREA
====================================================== -->

<section
    class="section"
    id="productArea"
>

    <div class="container">


        <!-- TOOLBAR -->

        <div class="products-toolbar">

            <div>

                <h2>
                    Trending Products
                </h2>

                <p id="productResultText">
                    সব products দেখানো হচ্ছে
                </p>

            </div>


            <div class="product-sort">

                <label for="sortProducts">
                    Sort:
                </label>

                <select
                    id="sortProducts"
                    onchange="sortProducts()"
                >

                    <option value="default">
                        Recommended
                    </option>

                    <option value="low">
                        Price: Low to High
                    </option>

                    <option value="high">
                        Price: High to Low
                    </option>

                    <option value="name">
                        Name: A-Z
                    </option>

                </select>

            </div>

        </div>



        <!-- =================================================
             CATEGORY FILTER
        ================================================== -->

        <div class="product-filters">


            <button
                class="product-filter active"
                onclick="
                    filterProducts('all', this)
                "
            >
                All
            </button>


            <button
                class="product-filter"
                onclick="
                    filterProducts('Fashion', this)
                "
            >
                👗 Fashion
            </button>


            <button
                class="product-filter"
                onclick="
                    filterProducts('Beauty', this)
                "
            >
                💄 Beauty
            </button>


            <button
                class="product-filter"
                onclick="
                    filterProducts('Food', this)
                "
            >
                🍔 Food
            </button>


            <button
                class="product-filter"
                onclick="
                    filterProducts('Electronics', this)
                "
            >
                📱 Electronics
            </button>


            <button
                class="product-filter"
                onclick="
                    filterProducts('Home', this)
                "
            >
                🏠 Home
            </button>


            <button
                class="product-filter"
                onclick="
                    filterProducts('Services', this)
                "
            >
                🛠️ Services
            </button>


        </div>



        <!-- =================================================
             PRODUCT GRID
        ================================================== -->

        <div
            class="product-grid marketplace-product-grid"
            id="productGrid"
        >



            <!-- PRODUCT 1 -->

            <article
                class="product-card marketplace-product-card"
                data-product="Ladies Three Piece"
                data-category="Fashion"
                data-price="1250"
            >

                <div
                    class="product-image"
                    style="
                        background-image:
                        url('https://images.unsplash.com/photo-1594633312681-425c7b97ccd1?auto=format&fit=crop&w=800&q=85');
                    "
                >

                    <span class="discount">
                        -20%
                    </span>


                    <button
                        class="product-heart"
                        onclick="
                            toggleWishlist(this)
                        "
                        aria-label="Wishlist"
                    >
                        ♡
                    </button>

                </div>


                <div class="product-info">

                    <div class="product-badge-row">

                        <span class="product-status">
                            🔥 Popular
                        </span>

                    </div>


                    <h3>
                        Ladies Three Piece
                    </h3>


                    <div class="product-brand verified-product-brand">

                        Anjona Ladies Tailors

                        <span
                            class="verified-badge small"
                            title="Verified Brand"
                        >
                            ✓
                        </span>

                    </div>


                    <div class="product-rating">
                        ⭐ 4.8
                        <span>
                            (24)
                        </span>
                    </div>


                    <div class="product-price">

                        <span class="current-price">
                            ৳1,250
                        </span>

                        <span class="old-price">
                            ৳1,550
                        </span>

                    </div>


                    <button
                        class="product-cart-btn"
                        onclick="
                            addToCart('Ladies Three Piece')
                        "
                    >
                        🛒 Add to Cart
                    </button>

                </div>

            </article>



            <!-- PRODUCT 2 -->

            <article
                class="product-card marketplace-product-card"
                data-product="Premium Attar"
                data-category="Beauty"
                data-price="650"
            >

                <div
                    class="product-image"
                    style="
                        background-image:
                        url('https://images.unsplash.com/photo-1541643600914-78b084683601?auto=format&fit=crop&w=800&q=85');
                    "
                >

                    <span class="discount">
                        -15%
                    </span>


                    <button
                        class="product-heart"
                        onclick="
                            toggleWishlist(this)
                        "
                        aria-label="Wishlist"
                    >
                        ♡
                    </button>

                </div>


                <div class="product-info">

                    <div class="product-badge-row">

                        <span class="product-status">
                            ⭐ Featured
                        </span>

                    </div>


                    <h3>
                        Premium Attar
                    </h3>


                    <div class="product-brand verified-product-brand">

                        Local Attar Shop

                        <span
                            class="verified-badge small"
                            title="Verified Brand"
                        >
                            ✓
                        </span>

                    </div>


                    <div class="product-rating">
                        ⭐ 4.9
                        <span>
                            (31)
                        </span>
                    </div>


                    <div class="product-price">

                        <span class="current-price">
                            ৳650
                        </span>

                        <span class="old-price">
                            ৳750
                        </span>

                    </div>


                    <button
                        class="product-cart-btn"
                        onclick="
                            addToCart('Premium Attar')
                        "
                    >
                        🛒 Add to Cart
                    </button>

                </div>

            </article>



            <!-- PRODUCT 3 -->

            <article
                class="product-card marketplace-product-card"
                data-product="Handmade Bag"
