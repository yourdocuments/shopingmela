                    </div>


                    <div class="product-price">

                        <span class="current-price">
                            ৳890
                        </span>

                    </div>


                    <button
                        class="product-cart-btn"
                        onclick="
                            addToCart('Handmade Bag')
                        "
                    >
                        🛒 Add to Cart
                    </button>

                </div>

            </article>



            <!-- PRODUCT 4 -->

            <article
                class="product-card marketplace-product-card"
                data-product="Homemade Food"
