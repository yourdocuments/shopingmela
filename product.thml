<!-- =====================================================
     JAVASCRIPT
====================================================== -->

<script>


/* =====================================================
   TOAST
====================================================== */

function showToast(message) {

    const toast =
        document.getElementById("toast");

    toast.textContent =
        message;

    toast.classList.add("show");


    setTimeout(function() {

        toast.classList.remove("show");

    }, 2500);

}



/* =====================================================
   FILTER PRODUCTS
====================================================== */

function filterProducts(category, button) {

    const products =
        document.querySelectorAll(
            ".product-item"
        );

    const buttons =
        document.querySelectorAll(
            ".product-filter"
        );

    let count = 0;


    buttons.forEach(function(btn) {

        btn.classList.remove("active");

    });


    if (button) {

        button.classList.add("active");

    }


    products.forEach(function(product) {

        const productCategory =
            product.dataset.category;


        if (
            category === "all" ||
            productCategory === category
        ) {

            product.style.display = "";

            count++;

        } else {

            product.style.display = "none";

        }

    });


    updateProductCount(count);


    const noResult =
        document.getElementById(
            "noProductResult"
        );


    if (count === 0) {

        noResult.classList.add("show");

    } else {

        noResult.classList.remove("show");

    }

}



/* =====================================================
   SEARCH PRODUCTS
====================================================== */

function searchProducts() {

    const input =
        document.getElementById(
            "productSearch"
        );


    const query =
        input.value
            .trim()
            .toLowerCase();


    const products =
        document.querySelectorAll(
            ".product-item"
        );


    if (!query) {

        resetProducts();

        return;

    }


    let count = 0;


    document
        .querySelectorAll(".product-filter")
        .forEach(function(button) {

            button.classList.remove(
                "active"
            );

        });


    products.forEach(function(product) {

        const name =
            product.dataset.name
                .toLowerCase();


        const category =
            product.dataset.category
                .toLowerCase();


        const text =
            product.innerText
                .toLowerCase();


        if (
            name.includes(query) ||
            category.includes(query) ||
            text.includes(query)
        ) {

            product.style.display = "";

            count++;

        } else {

            product.style.display = "none";

        }

    });


    updateProductCount(count);


    const noResult =
        document.getElementById(
            "noProductResult"
        );


    if (count === 0) {

        noResult.classList.add("show");

        showToast(
            "কোনো Product পাওয়া যায়নি"
        );

    } else {

        noResult.classList.remove("show");

        showToast(
            count +
            "টি Product পাওয়া গেছে 🔎"
        );

    }

}



/* =====================================================
   ENTER KEY
====================================================== */

document
    .getElementById("productSearch")
    .addEventListener(
        "keydown",
        function(event) {

            if (
                event.key === "Enter"
            ) {

                searchProducts();

            }

        }
    );



/* =====================================================
   UPDATE PRODUCT COUNT
====================================================== */

function updateProductCount(count) {

    const counter =
        document.getElementById(
            "productCount"
        );


    if (count === 0) {

        counter.textContent =
            "No products found";

    } else {

        counter.textContent =
            "Showing " +
            count +
            " product" +
            (count > 1 ? "s" : "");

    }

}



/* =====================================================
   SORT PRODUCTS
====================================================== */

function sortProducts() {

    const select =
        document.getElementById(
            "sortProducts"
        );


    const value =
        select.value;


    const grid =
        document.getElementById(
            "productGrid"
        );


    const products =
        Array.from(
            grid.querySelectorAll(
                ".product-item"
            )
        );


    if (value === "low") {

        products.sort(function(a, b) {

            return (
                Number(a.dataset.price) -
                Number(b.dataset.price)
            );

        });

    }


    else if (value === "high") {

        products.sort(function(a, b) {

            return (
                Number(b.dataset.price) -
                Number(a.dataset.price)
            );

        });

    }


    else if (value === "rating") {

        products.sort(function(a, b) {

            return (
                Number(b.dataset.rating) -
                Number(a.dataset.rating)
            );

        });

    }


    products.forEach(function(product) {

        grid.appendChild(product);

    });


    showToast(
        "Products sorted successfully"
    );

}



/* =====================================================
   WISHLIST
====================================================== */

function addWishlist(button) {

    button.classList.toggle(
        "liked"
    );


    if (
        button.classList.contains(
            "liked"
        )
    ) {

        button.textContent =
            "♥";

        showToast(
            "Wishlist-এ যোগ করা হয়েছে ❤️"
        );

    } else {

        button.textContent =
            "♡";

        showToast(
            "Wishlist থেকে সরানো হয়েছে"
        );

    }

}



/* =====================================================
   VIEW PRODUCT
====================================================== */

function viewProduct(productName) {

    showToast(
        productName +
        " details শীঘ্রই আসছে!"
    );

}



/* =====================================================
   RESET
====================================================== */

function resetProducts() {

    const products =
        document.querySelectorAll(
            ".product-item"
        );


    const buttons =
        document.querySelectorAll(
            ".product-filter"
        );


    products.forEach(function(product) {

        product.style.display = "";

    });


    buttons.forEach(function(button) {

        button.classList.remove(
            "active"
        );

    });


    const allButton =
        document.querySelector(
            '[data-filter="all"]'
        );


    if (allButton) {

        allButton.classList.add(
            "active"
        );

    }


    document
        .getElementById(
            "productSearch"
        )
        .value = "";


    document
        .getElementById(
            "noProductResult"
        )
        .classList.remove(
            "show"
        );


    updateProductCount(
        products.length
    );

}



/* =====================================================
   INITIAL COUNT
====================================================== */

document.addEventListener(
    "DOMContentLoaded",
    function() {

        const products =
            document.querySelectorAll(
                ".product-item"
            );

        updateProductCount(
            products.length
        );

    }
);


</script>


</body>

</html>
```
