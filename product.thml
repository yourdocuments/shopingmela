                data-price="1150"
            >

                <div
                    class="product-image"
                    style="
                        background-image:
                        url('https://images.unsplash.com/photo-1507473885765-e6ed057f782c?auto=format&fit=crop&w=800&q=85');
                    "
                >

                    <span class="discount">
                        -18%
                    </span>


                    <button
                        class="product-heart"
                        onclick="
                            toggleWishlist(this)
                        "
                        aria-label="Wishlist"
                    >
                        ♡
                    </button>

                </div>


                <div class="product-info">

                    <div class="product-badge-row">

                        <span class="product-status">
                            ⭐ Featured
                        </span>

                    </div>


                    <h3>
                        Home Decor Lamp
                    </h3>


                    <div class="product-brand verified-product-brand">

                        Home Decor BD

                        <span
                            class="verified-badge small"
                            title="Verified Brand"
                        >
                            ✓
                        </span>

                    </div>


                    <div class="product-rating">
                        ⭐ 4.7
                        <span>
                            (15)
                        </span>
                    </div>


                    <div class="product-price">

                        <span class="current-price">
                            ৳1,150
                        </span>

                        <span class="old-price">
                            ৳1,400
                        </span>

                    </div>


                    <button
                        class="product-cart-btn"
                        onclick="
                            addToCart('Home Decor Lamp')
                        "
                    >
