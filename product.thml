            >

                <div
                    class="product-image"
                    style="
                        background-image:
                        url('https://images.unsplash.com/photo-1606220945770-b5b6c2c55bf1?auto=format&fit=crop&w=800&q=85');
                    "
                >

                    <span class="discount">
                        -12%
                    </span>


                    <button
                        class="product-heart"
                        onclick="
                            toggleWishlist(this)
                        "
                        aria-label="Wishlist"
                    >
                        ♡
                    </button>

                </div>


                <div class="product-info">

                    <div class="product-badge-row">

                        <span class="product-status">
                            ⚡ Trending
                        </span>

                    </div>


                    <h3>
                        Wireless Earbuds
                    </h3>


                    <div class="product-brand verified-product-brand">

                        Mela Electronics

                        <span
                            class="verified-badge small"
                            title="Verified Brand"
                        >
                            ✓
                        </span>

                    </div>


                    <div class="product-rating">
                        ⭐ 4.6
                        <span>
                            (19)
                        </span>
                    </div>


                    <div class="product-price">

                        <span class="current-price">
                            ৳1,450
                        </span>

                        <span class="old-price">
                            ৳1,650
                        </span>

                    </div>


                    <button
                        class="product-cart-btn"
                        onclick="
                            addToCart('Wireless Earbuds')
                        "
                    >
                        🛒 Add to Cart
                    </button>

                </div>

            </article>



            <!-- PRODUCT 6 -->

            <article
                class="product-card marketplace-product-card"
                data-product="Home Decor Lamp"
